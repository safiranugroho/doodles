{
  "name": "@safiranugroho/doodles",
  "version": "1.0.0",
  "scripts": {
    "dev": "concurrently \"NODE_ENV=dev npm run build:components --watch\" \"vite dev\"",
    "build": "npm run build:components && vite build",
    "build:components": "svelte-kit sync && rollup --config",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json --watch",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "semantic-release": "semantic-release"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-alias": "^6.0.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-image": "^3.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.8",
    "@types/prismjs": "^1.26.6",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.5",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.13.0",
    "postcss": "^8.5.28",
    "postcss-css-variables": "^0.19.0",
    "postcss-import": "^17.0.0",
    "postcss-import-url": "^7.2.0",
    "postcss-load-config": "^6.0.1",
    "postcss-remove-root": "^0.0.2",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "rollup": "^4.64.0",
    "rollup-plugin-postcss": "^4.0.2",
    "rollup-plugin-svelte": "^7.2.3",
    "semantic-release": "^25.0.9",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "svelte-preprocess": "^6.0.5",
    "tslib": "^2.8.1",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2"
  },
  "type": "module",
  "exports": {
    "./components": "./package/web-components.min.js",
    "./metadata": "./package/web-components-metadata.min.js",
    "./fonts": "./package/web-components-fonts.css"
  },
  "files": [
    "package/web-components.min.js",
    "package/web-components.min.js.map",
    "package/web-components-fonts.css",
    "package/web-components-metadata.min.js",
    "package/web-components-metadata.min.js.map"
  ],
  "dependencies": {
    "@sveltejs/adapter-vercel": "^7.0.0",
    "prismjs": "^1.30.0",
    "quagga": "^0.12.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/safiranugroho/doodles.git"
  },
  "engines": {
    "node": "24.x"
  },
  "imports": {
    "#lib": "./src/lib",
    "#lib/*": "./src/lib/*"
  }
}
